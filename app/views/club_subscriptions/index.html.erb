<main class="club-subscriptions-page" aria-labelledby="club-subscriptions-title">
  <div class="club-subscriptions-shell">
    <header class="club-subscriptions-header">
      <span class="club-subscriptions-kicker">Gestão de assinaturas</span>
      <h1 id="club-subscriptions-title">Meus planos</h1>
      <p>Consulte e altere as assinaturas dos clubes que você administra.</p>
    </header>

    <% if @clubs.any? %>
      <section class="club-subscriptions-grid" aria-label="Assinaturas dos meus clubes">
        <% @clubs.each do |club| %>
          <% subscription = club.active_club_subscription %>
          <% plan = subscription&.plan %>
          <article class="club-subscription-card">
            <div class="club-subscription-card__header">
              <span class="club-subscription-card__label">Clube</span>
              <h2><%= club.name %></h2>
            </div>

            <% if subscription && plan %>
              <dl class="club-subscription-card__details">
                <div>
                  <dt>Assinatura atual</dt>
                  <dd><%= plan.name %></dd>
                </div>
                <div>
                  <dt>Valor</dt>
                  <dd><%= number_to_currency(plan.price, unit: "R$ ", separator: ",", delimiter: ".") %> / <%= plan.monthly? ? "mês" : "ano" %></dd>
                </div>
                <div>
                  <dt>Expiração da assinatura</dt>
                  <dd><%= subscription.expires_at.present? ? l(subscription.expires_at.to_date) : "Não definida" %></dd>
                </div>
              </dl>

              <% pending_change = club.pending_subscription_change %>
              <% if pending_change %>
                <section class="club-subscription-pending" aria-label="Downgrade agendado">
                  <span class="club-subscription-pending__eyebrow">Downgrade agendado</span>
                  <strong><%= pending_change.new_plan.name %></strong>
                  <p>
                    Aplicação em <%= l(pending_change.effective_at.to_date) %>.
                    O plano atual continua ativo até essa data.
                  </p>
                  <%= button_to "Cancelar downgrade",
                                club_subscription_change_path(club),
                                method: :delete,
                                class: "club-subscription-card__action club-subscription-card__action--secondary",
                                data: { turbo_confirm: "Cancelar o downgrade agendado?" } %>
                </section>
              <% end %>

            <% else %>
              <div class="club-subscription-card__empty">
                <strong>Nenhuma assinatura ativa</strong>
                <p>Escolha um plano para começar a utilizar o clube.</p>
              </div>
            <% end %>

            <%= link_to(subscription ? "Mudar assinatura" : "Contratar plano",
                        root_path(anchor: "planos"),
                        class: "club-subscription-card__action") %>

            <% if subscription && @free_plan && plan != @free_plan && pending_change.nil? && plan.downgrade_to?(@free_plan) %>
              <div class="club-subscription-cancellation" data-controller="subscription-cancellation">
                <p class="club-subscription-cancel-link">
                  <button type="button"
                          class="club-subscription-cancel-link__button"
                          data-action="subscription-cancellation#open">
                    Cancelamento de assinatura
                  </button>
                </p>

                <dialog class="subscription-change-dialog"
                        aria-labelledby="subscription-cancellation-dialog-title-<%= club.id %>"
                        data-subscription-cancellation-target="dialog"
                        data-action="click->subscription-cancellation#closeOnBackdrop">
                  <div class="subscription-change-dialog__card">
                    <button type="button"
                            class="subscription-change-dialog__close"
                            aria-label="Fechar confirmação"
                            data-action="subscription-cancellation#close">×</button>
                    <span class="subscription-change-label">Cancelamento de assinatura</span>
                    <h2 id="subscription-cancellation-dialog-title-<%= club.id %>">Cancelar assinatura?</h2>
                    <p class="subscription-change-dialog__warning">
                      O plano <strong><%= plan.name %></strong> continuará ativo até a expiração.
                      Depois disso, o clube será rebaixado para o plano Free, sem novas cobranças no Asaas.
                    </p>
                    <%= form_with url: club_subscription_change_path(club),
                                  method: :post,
                                  scope: :subscription_change,
                                  class: "subscription-change-dialog__form" do |form| %>
                      <%= form.hidden_field :new_plan_id, value: @free_plan.id %>
                      <div class="subscription-change-dialog__actions">
                        <button type="button"
                                class="subscription-change-dialog__cancel"
                                data-action="subscription-cancellation#close">
                          Voltar
                        </button>
                        <%= form.submit "Confirmar cancelamento", class: "club-subscription-submit" %>
                      </div>
                    <% end %>
                  </div>
                </dialog>
              </div>
            <% end %>
          </article>
        <% end %>
      </section>
    <% else %>
      <section class="club-subscriptions-empty" aria-live="polite">
        <h2>Nenhum clube disponível</h2>
        <p>Crie um clube ou torne-se owner de um clube para gerenciar planos.</p>
        <%= link_to "Meus clubes", clubs_path, class: "club-subscription-card__action" %>
      </section>
    <% end %>
  </div>
</main>
