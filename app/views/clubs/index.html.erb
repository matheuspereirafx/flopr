<div class="clubs-page">

  <div class="clubs-header">

    <div>
      <h1>Meus Clubes</h1>

      <p>
        Gerencie suas organizações de pôquer, visualize torneios ativos
        e acompanhe as estatísticas dos membros em todos os seus locais.
      </p>

    </div>

    <%= link_to "Criar Novo Clube",
        new_club_path,
        class: "btn-primary" %>

  </div>


  <div class="clubs-toolbar">

      <input
        type="text"
        placeholder="Pesquise clubes..."
        class="search-input">

      <button class="secondary-button">
        Filtro
      </button>

      <button class="secondary-button">
        Ordenar
      </button>

  </div>



  <div class="clubs-grid">

      <% @clubs.each do |club| %>

          <%= render "shared/components/club_card",
              club: club %>

      <% end %>

  </div>

</div>
