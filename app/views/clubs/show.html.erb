<div class="club-dashboard">

  <%# Fundo decorativo da página %>
  <div class="club-dashboard__background"></div>

  <main class="club-dashboard__container">

    <%# =========================
        CABEÇALHO DO CLUBE
    ========================== %>
    <section class="club-hero">

      <div class="club-hero__content">

        <h1 class="club-hero__title">
          <%= @club.name %>
        </h1>

        <%# O titulo precisa ser dinamico  %>
        <p class="club-hero__description">
          Gerencie seus torneios, acompanhe eventos ao vivo e revise os resultados.
        </p>

        <%# Sem direcionamento por enquanto %>
        <button type="button" class="club-hero__button">
          <i class="fa-solid fa-plus"></i>
          Criar novo torneio
        </button>

      </div>

      <div class="club-hero__players">

        <span class="club-hero__players-label">
        <%# Dinamico %>

          Jogadores ativos
        </span>

        <strong class="club-hero__players-number">
          128
        </strong>

      </div>

    </section>

    <%# =========================
        EVENTOS
    ========================== %>
    <section class="club-events">

      <header class="club-events__header">

        <h2 class="club-events__title">
          Eventos
        </h2>

        <div class="club-events__filters">

          <button
            type="button"
            class="club-events__filter"
          >
            Todos
          </button>

          <button
            type="button"
            class="club-events__filter club-events__filter--active"
          >
            Ao vivo
          </button>

          <button
            type="button"
            class="club-events__filter"
          >
            Próximos
          </button>

        </div>

      </header>

      <div class="club-events__grid">

        <%# =========================
            CARD 1 — AO VIVO
        ========================== %>
        <article class="event-card event-card--featured">

          <div class="event-card__media">

            <%# Adicione sua imagem posteriormente
                app/assets/images/events/sunday-million.jpg

                Depois, remova o símbolo # da linha abaixo.
            %>

            <%#= image_tag "events/sunday-million.jpg",
                  alt: "Sunday Million High Roller",
                  class: "event-card__image" %>

            <span class="event-card__status event-card__status--live">
              <span class="event-card__status-dot"></span>
              Ao vivo
            </span>

          </div>

          <div class="event-card__content">

            <div class="event-card__main">

              <h3 class="event-card__title">
                Sunday Million High Roller
              </h3>

              <p class="event-card__subtitle">
                No Limit Hold’em • Freezeout
              </p>

              <div class="event-card__metrics">

                <div class="event-card__metric">
                  <span class="event-card__metric-label">
                    <i class="fa-solid fa-coins"></i>
                    Premiação
                  </span>

                  <strong class="event-card__metric-value">
                    R$ 250.000
                  </strong>
                </div>

                <div class="event-card__metric">
                  <span class="event-card__metric-label">
                    <i class="fa-solid fa-users"></i>
                    Restantes
                  </span>

                  <strong class="event-card__metric-value">
                    45
                    <small>/ 120</small>
                  </strong>
                </div>

              </div>

            </div>

            <footer class="event-card__footer">

              <span class="event-card__level">
                <i class="fa-regular fa-clock"></i>
                Nível 12 (1k/2k)
              </span>

              <button type="button" class="event-card__details-button">
                Ver detalhes
                <i class="fa-solid fa-arrow-right"></i>
              </button>

            </footer>

          </div>

        </article>

        <%# =========================
            CARD 2 — INSCRIÇÕES
        ========================== %>
        <article class="event-card">

          <div class="event-card__content event-card__content--full">

            <header class="event-card__top">

              <span class="event-card__status">
                Inscrições abertas
              </span>

              <div class="event-card__starts">
                <span>Começa em</span>
                <strong>2h 15min</strong>
              </div>

            </header>

            <div class="event-card__center">

              <h3 class="event-card__title">
                Weekly Turbo Deepstack
              </h3>

              <p class="event-card__subtitle">
                No Limit Hold’em • Reentrada
              </p>

            </div>

            <footer class="event-card__buy-in">

              <span class="event-card__buy-in-label">
                Buy-in
              </span>

              <strong class="event-card__buy-in-value">
                R$ 100
                <small>+ R$ 50</small>
              </strong>

            </footer>

          </div>

        </article>

        <%# =========================
            CARD 3 — PRÓXIMO
        ========================== %>
        <article class="event-card">

          <div class="event-card__media">

            <%# Adicione sua imagem posteriormente nesta pasta:
                app/assets/images/events/omaha-championship.jpg

                Depois, remova o símbolo # da linha abaixo.
            %>

            <%#= image_tag "events/omaha-championship.jpg",
                  alt: "Omaha Pot Limit Championship",
                  class: "event-card__image" %>

            <span class="event-card__status">
              Próximo
            </span>

          </div>

          <div class="event-card__content">

            <div class="event-card__main">

              <h3 class="event-card__title">
                Omaha Pot Limit Championship
              </h3>

              <p class="event-card__subtitle">
                PLO • 6-Max
              </p>

            </div>

            <footer class="event-card__buy-in event-card__buy-in--horizontal">

              <div>
                <span class="event-card__buy-in-label">
                  Buy-in
                </span>

                <strong class="event-card__buy-in-value">
                  R$ 50
                </strong>
              </div>

              <div class="event-card__date">
                <span>Amanhã</span>
                <strong>18:00</strong>
              </div>

            </footer>

          </div>

        </article>

      </div>

    </section>

  </main>

</div>
