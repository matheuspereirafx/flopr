<main class="club-show-page">

  <section class="club-show-hero">

    <div class="club-show-hero__content">

      <%# Nome Clube %>
      <h1 class="club-show-hero__title">
        <%= @club.name %>
      </h1>

      <p class="club-show-hero__description">
        Gerencie seus torneios, acompanhe eventos ao vivo e consulte os resultados.
      </p>

      <% if @club.can_create_tournament? %>
        <%= render "shared/components/buttons/button_create",
            text: "Criar Novo Torneio",
            path: new_club_tournament_path(@club),
            class: "width-g club-show__create-tournament",
            data: { turbo_prefetch: false } %>
      <% else %>
        <% active_plan = @club.active_plan %>
        <% monthly_tournament_limit = active_plan.monthly_tournament_limit %>
        <div data-controller="plan-limit-modal">
          <button type="button"
                  class="btn-primary width-g club-show__create-tournament"
                  data-action="plan-limit-modal#open">
            <span class="btn-icon">+</span>
            <span>Criar Novo Torneio</span>
          </button>

          <dialog class="plan-limit-modal"
                  data-plan-limit-modal-target="dialog"
                  data-action="click->plan-limit-modal#closeOnBackdrop"
                  aria-labelledby="tournament-limit-title">
            <div class="plan-limit-modal__card">
              <button type="button"
                      class="plan-limit-modal__close"
                      aria-label="Fechar"
                      data-action="plan-limit-modal#close">
                ×
              </button>
              <p class="plan-limit-modal__eyebrow">Limite do plano <%= active_plan.name %></p>
              <h2 id="tournament-limit-title">Limite mensal atingido</h2>
              <p>O plano <%= active_plan.name %> permite criar <%= pluralize(monthly_tournament_limit, "torneio", "torneios") %> por mês.</p>
              <button type="button"
                      class="plan-limit-modal__confirm"
                      data-action="plan-limit-modal#close">
                Entendi
              </button>
            </div>
          </dialog>
        </div>
      <% end %>

    </div>

    <div class="club-show-hero__players">

      <span class="club-show-hero__players-label">
        Jogadores ativos
      </span>

      <strong class="club-show-hero__players-count">
        <%= @active_players_count %>
      </strong>

    </div>

  </section>


  <%# Cards de torneio sem ligacao Backend %>
<%= render "shared/components/tournaments/card_tournaments",
           tournaments: @tournaments,
           current_membership: @current_membership,
           confirmed_registrations_by_tournament: @confirmed_registrations_by_tournament %>

</main>
