<div class="signup-page">

  <div class="signup-card">

    <h1>Create your account</h1>

    <p class="subtitle">
      Professional poker tournament management at your fingertips.
    </p>

    <div class="card-signup">

      <%= simple_form_for(resource,
            as: resource_name,
            url: registration_path(resource_name)) do |f| %>

        <%# Nickname %>

        <%# Email %>
        <div class="field">

          <label>Email address</label>

          <div class="input-wrapper">

            <%= image_tag "icons/iconemail.svg",
                  class: "input-icon" %>

            <%= f.input :email,
                  label: false,
                  required: true,
                  input_html: {
                    autocomplete: "email",
                    placeholder: "name@company.com"
                  } %>

          </div>

        </div>

        <%# Password %>
        <div class="field">

          <label>Password</label>

          <div
            class="input-wrapper"
            data-controller="password-toggle">

            <%= image_tag "icons/iconpassoword.svg",
                  class: "input-icon" %>

            <%= f.input :password,
                  label: false,
                  required: true,
                  input_html: {
                    autocomplete: "new-password",
                    placeholder: "••••••••",
                    data: {
                      password_toggle_target: "input"
                    }
                  } %>

            <button
              type="button"
              class="toggle-password"
              data-action="click->password-toggle#toggle">

              <i
                class="fa-regular fa-eye"
                data-password-toggle-target="icon"></i>

            </button>

          </div>

        </div>

        <%# Confirm Password %>
        <div class="field">

          <label>Confirm Password</label>

          <div class="input-wrapper">

            <%= image_tag "icons/confirmedicon.svg",
                  class: "input-icon" %>

            <%= f.input :password_confirmation,
                  label: false,
                  required: true,
                  input_html: {
                    autocomplete: "new-password",
                    placeholder: "••••••••"
                  } %>

          </div>

        </div>

        <div class="terms">

          <%= check_box_tag :terms %>

          <label for="terms">
            I agree to the
            <a href="#">Terms of Service</a>
            and
            <a href="#">Privacy Policy</a>.
          </label>

        </div>

        <%= f.button :submit,
              "Create Account →",
              class: "signup-btn" %>

      <% end %>

    </div>

    <div class="divider">
      <span>or</span>
    </div>

    <p class="signup-footer">
      Already have an account?

      <%= link_to "Log In",
            new_session_path(resource_name) %>
    </p>

  </div>

</div>
