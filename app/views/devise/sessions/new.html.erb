<div class="login-page">

  <div class="login-card">

    <h1 class="tittle" >Bem Vindo</h1>

    <p class="subtitle">
      Insira suas credenciais para começar.
    </p>

    <%= simple_form_for(resource,
          as: resource_name,
          url: session_path(resource_name)) do |f| %>

      <div class="field">

        <label>Email</label>

        <div class="input-wrapper">

          <i class="fa-regular fa-envelope"></i>

          <%= f.input :email,
            label: false,
            required: false,
            input_html: {
              autocomplete: "email",
              placeholder: "name@company.com"
            } %>

        </div>

      </div>


      <div class="field">

        <div class="password-header">

          <label>Password</label>

          <%= link_to "Forgot password?",
                new_password_path(resource_name) %>

        </div>


        <div
          class="input-wrapper"
          data-controller="password-toggle">

          <i class="fa-solid fa-lock"></i>

          <%= f.input :password,
                label: false,
                required: false,
                input_html: {
                  autocomplete: "current-password",
                  placeholder: "••••••••",
                  data: {
                    password_toggle_target: "input"
                  }
                } %>

          <button
            type="button"
            class="toggle-password"
            data-action="click->password-toggle#toggle">

            <i
              class="fa-regular fa-eye"
              data-password-toggle-target="icon"></i>

          </button>

        </div>

      </div>


      <%= f.button :submit,
            "Sign In",
            class: "login-btn" %>

    <% end %>

    <p class="signup">
      Não tem uma conta?

      <%= link_to "Sign Up",
            new_registration_path(resource_name) %>

    </p>

  </div>

</div>
