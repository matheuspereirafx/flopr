<div class="login-page">

  <div class="login-card">

    <h1>Bem Vindo</h1>

    <p class="subtitle">
      Insira suas credenciais para começar.
    </p>

    <div class="card-login">
      <%= simple_form_for(resource,
          as: resource_name,
          url: session_path(resource_name)) do |f| %>

      <%# Email %>
      <div class="field">

        <label>Email</label>

        <div class="input-wrapper">

          <%# Icon Email%>
          <i class="fa-regular fa-envelope"></i>

          <%= f.input :email,
            label: false,
            required: false,
            input_html: {
              autocomplete: "email",
              placeholder: "name@company.com"
            } %>

        </div>

      </div>

      <%# Password%>
      <div class="field">

        <div class="password-header">

          <label>Senha</label>

          <%= link_to "Esqueceu sua senha?",
                new_password_path(resource_name) %>
        </div>


        <div
          class="input-wrapper"
          data-controller="password-toggle">

          <%# Icon Password%>
          <i class="fa-solid fa-lock"></i>

          <%= f.input :password,
                label: false,
                required: false,
                input_html: {
                  autocomplete: "current-password",
                  placeholder: "••••••••",
                  data: {
                    password_toggle_target: "input"
                  }
                } %>

          <%# Toggle-password%>
          <button
            type="button"
            class="toggle-password"
            data-action="click->password-toggle#toggle">

            <%# Icon toggle Password%>
            <i
              class="fa-regular fa-eye"
              data-password-toggle-target="icon"></i>

          </button>

        </div>

      </div>


      <%= f.button :submit,
            "Entrar",
            class: "login-btn" %>

      <% end %>
    </div>
    <p class="signup">
      Não tem uma conta?

      <%= link_to "Entrar",
            new_registration_path(resource_name) %>

    </p>

  </div>

</div>
