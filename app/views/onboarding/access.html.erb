<div class="profile-page" data-controller="profile-selector">

  <%# Effects Background %>
  <div class="background background-left"></div>
  <div class="background background-right"></div>

  <div class="profile-card">

    <div class="profile-header">

      <div class="profile-icon">
        <i class="fa-regular fa-id-card"></i>
      </div>

      <h1 class="tittle" id="tittle-size">Selecione o perfil</h1>

      <p class="sub-tittle" id="subtittle-size">
        Como você deseja usar a plataforma Flopr?
      </p>

    </div>

    <div class="profiles">
      <%# Profile Host %>
      <div
        class="profile-option"
        data-action="click->profile-selector#select"
        data-profile-selector-target="option"
        data-value="organizer">

        <div class="radio"></div>

        <div class="icon">
          <i class="fa-regular fa-folder-open"></i>
        </div>

        <h2>Organizador</h2>

        <p class="sub-tittle" id="subtittle-size" >
          Gerencie seus torneios e clubes com precisão profissional.
        </p>

      </div>

       <%# Profile Player %>
      <div
        class="profile-option"
        data-action="click->profile-selector#select"
        data-profile-selector-target="option"
        data-value="player">

        <div class="radio"></div>

        <div class="icon">
          <i class="fa-regular fa-credit-card"></i>
        </div>

        <h2>Jogador</h2>

        <p class="sub-tittle" id="subtittle-size">
          Encontre os melhores jogos e acompanhe sua evolução.
        </p>

      </div>

    </div>

    <%= link_to "Continuar",
        "#",
        class:"continue-btn",
        data:{ profile_selector_target:"button"} %>

  </div>


</div>
