<article class="landing-plan<%= ' landing-plan--highlighted' if local_assigns[:highlighted] %>">
  <% if local_assigns[:highlighted] %><span class="landing-plan__badge">Mais popular</span><% end %>
  <div class="landing-plan__body">
    <div class="landing-plan__intro"><h3><%= plan.name %></h3><p><%= plan.description %></p></div>
    <div class="landing-plan__price-row">
      <strong class="landing-plan__price"><%= number_to_currency(plan.price, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
      <small>/ <%= plan.monthly? ? "mês" : "ano" %></small>
      <% if local_assigns[:annual_price] %><span class="landing-plan__annual"><%= annual_price %></span><% end %>
    </div>
    <ul>
      <% features.each do |feature| %>
        <% unavailable = feature[:state].to_sym == :unavailable %>
        <li class="<%= 'is-unavailable' if unavailable %>">
          <%= image_tag(unavailable ? "landing/pricing-cross.svg" : (local_assigns[:highlighted] ? "landing/pricing-check-highlighted.svg" : "landing/pricing-check.svg"), alt: "", aria: { hidden: true }) %>
          <%= feature[:text] %>
        </li>
      <% end %>
    </ul>
  </div>
  <%= link_to action, new_club_subscription_path(plan_id: plan.id), class: "landing-plan__action" %>
</article>
