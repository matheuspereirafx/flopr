<nav class="app-navbar <%= "app-navbar--tournament-area" if tournament_area? %>" aria-label="Navegação autenticada">
  <%= link_to root_path, class: "app-navbar__brand", aria: { label: "Flopr - início" } do %>
    <span>Flopr</span><strong aria-hidden="true">.</strong>
  <% end %>

  <% unless tournament_area? %>
    <div class="app-navbar__links">
      <%= link_to "Organizador", clubs_path,
                  class: ["app-navbar__link", ("is-active" if controller_name == "clubs")] %>
      <%= link_to "Player", player_tournaments_path,
                  class: ["app-navbar__link", ("is-active" if tournament_area? || controller_name == "player_tournaments")] %>
    </div>
  <% end %>

  <div
    class="app-navbar__profile-menu"
    data-controller="inside-menu"
    data-action="click@window->inside-menu#closeOutside">
    <button
      class="app-navbar__profile"
      type="button"
      aria-label="Abrir menu de perfil"
      aria-expanded="false"
      data-inside-menu-target="button"
      data-action="click->inside-menu#toggle">
      <%= image_tag "https://kitt.lewagon.com/placeholder/users/ssaunier", alt: "" %>
    </button>

    <div
      class="app-navbar__profile-dropdown"
      data-inside-menu-target="dropdown"
      hidden>
      <%= link_to "Meu perfil", onboarding_profile_path, class: "app-navbar__profile-link" %>
      <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "app-navbar__profile-link app-navbar__profile-link--danger" %>
    </div>
  </div>
</nav>
