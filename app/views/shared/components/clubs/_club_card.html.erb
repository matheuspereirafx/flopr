<div class="club-card">

  <div class="club-card-header">

    <%= render "shared/components/clubs/club_logo",
      club: club %>

    <div class="club-info">
      <h3><%= club.name %></h3>

      <span class="count-member">
        0 membros
      </span>
    </div>

    <%= render "shared/components/clubs/club_menu_card",
      club: club %>

  </div>


  <%= render "shared/components/clubs/club_tournament_card",
      club: club %>

  <%#= link_to "Gerenciar clube",
      club_path(club),
      class: "club-button" %>

</div>
