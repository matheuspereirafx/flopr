<% tournament ||= nil %>
<% tournament_live = tournament&.clock_state&.running? || tournament&.clock_state&.paused? || tournament&.clock_state&.overtime? %>
<% tournament_state = tournament_live ? :live : (tournament.present? ? :scheduled : :empty) %>
<article class="club-card club-card--<%= tournament_state %>">

  <%= link_to club_path(club),
      class: "club-card-link",
      data: { turbo_prefetch: false },
      aria: { label: "Abrir #{club.name}" } do %>
  <% end %>

  <div class="club-card-header">

    <%= render "shared/components/clubs/club_logo",
      club: club %>

    <div class="club-info">
      <h3><%= club.name %></h3>

      <span class="count-member">
        <%= club.club_memberships.size %> <%= club.club_memberships.size == 1 ? 'membro' : 'membros' %>
      </span>
    </div>

    <%= render "shared/components/clubs/club_menu_card",
      club: club %>

  </div>


  <%= render "shared/components/clubs/club_tournament_card",
      club: club,
      tournament: tournament,
      state: tournament_state %>

  <div class="club-card__footer">
    <%= link_to "Gerenciar clube", club_path(club), class: "club-card__manage", data: { turbo_prefetch: false } %>
  </div>

</article>
