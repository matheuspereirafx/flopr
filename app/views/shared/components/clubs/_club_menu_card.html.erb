<div
  class="inside-menu"
  data-controller="inside-menu"
  data-action="click@window->inside-menu#closeOutside">

  <button
    class="menu-button"
    type="button"
    aria-label="Abrir opções do inside"
    aria-expanded="false"
    data-inside-menu-target="button"
    data-action="click->inside-menu#toggle"
  >
    ⋮
  </button>

  <div
    class="inside-menu-dropdown"
    data-inside-menu-target="dropdown"
    hidden
  >
    <%= link_to edit_club_path(club),
        class: "inside-menu-item" do %>

      <span>Editar clube</span>

    <% end %>

    <%= button_to club_path(club),
        method: :delete,
        class: "inside-menu-item inside-menu-item--danger",
        form: {
          data: {
            turbo_confirm: "Tem certeza que deseja excluir este clube?"
          }
        } do %>

      <span>Excluir clube</span>

    <% end %>
  </div>
</div>
