<% recharge_time = recharge.created_at.in_time_zone("America/Sao_Paulo") %>
<article class="recharge-history-item">
  <div class="recharge-history-item__details">
    <span class="recharge-history-item__icon" aria-hidden="true">+</span>
    <div>
      <strong><%= recharge.tournament_charge_option.kind.humanize %></strong>
      <time datetime="<%= recharge_time.iso8601 %>">
        <%= l(recharge_time, format: :short) %>
      </time>
      <span class="recharge-history-item__payment-details">
        <span><%= number_to_currency(recharge.amount) %></span>
        <% if recharge.tournament_charge_option.chip_amount.present? %>
          <span><%= number_with_delimiter(recharge.tournament_charge_option.chip_amount) %> fichas</span>
        <% end %>
      </span>
    </div>
  </div>

  <span class="recharge-request-status recharge-request-status--<%= recharge.status %>">
    <%= {
          "pending" => "Pendente",
          "paid" => "Pago",
          "failed" => "Falhou",
          "cancelled" => "Cancelado",
          "refunded" => "Reembolsado"
        }.fetch(recharge.status, recharge.status.humanize) %>
  </span>
</article>
