<% registration = transaction.tournament_registration %>
<% charge_option = transaction.tournament_charge_option %>
<% transaction_time = (transaction.paid_at || transaction.created_at).in_time_zone("America/Sao_Paulo") %>
<tr class="transactions-table__row">
  <th scope="row" class="transactions-table__player">
    <span class="transactions-table__player-content">
      <span class="transactions-table__avatar" aria-hidden="true">
        <%= registration.user.name.to_s.first(2).upcase %>
      </span>
      <span class="transactions-table__player-details">
        <span class="transactions-table__player-name"><%= registration.user.name %></span>
        <% if registration.user.username.present? %>
          <span class="transactions-table__player-username">@<%= registration.user.username %></span>
        <% end %>
      </span>
    </span>
  </th>
  <td class="transactions-table__product">
    <%= charge_option.kind.humanize %>
  </td>
  <td class="transactions-table__amount">
    <strong data-amount="<%= transaction.amount %>"><%= number_to_currency(transaction.amount) %></strong>
    <% if charge_option.chip_amount.present? %>
      <small><%= number_with_delimiter(charge_option.chip_amount) %> fichas</small>
    <% end %>
  </td>
  <td>
    <span class="transactions-status transactions-status--<%= transaction.status %>">
      <%= if transaction.paid?
            "Pago"
          elsif transaction.pending?
            "Pendente"
          else
            transaction.status.humanize
          end %>
    </span>
  </td>
  <td class="transactions-table__date">
    <time datetime="<%= transaction_time.iso8601 %>">
      <%= l(transaction_time, format: :short) %>
    </time>
  </td>
  <td class="transactions-table__action">
    <% if transaction.pending? %>
      <%= button_to "Confirmar",
                    confirm_club_tournament_transaction_path(club, tournament, transaction),
                    method: :patch,
                    class: "transactions-table__confirm" %>
    <% else %>
      <span class="transactions-table__confirmed">—</span>
    <% end %>
  </td>
</tr>
