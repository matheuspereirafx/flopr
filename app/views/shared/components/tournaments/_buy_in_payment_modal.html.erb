<div class="tournament-buy-in-modal"
     data-buy-in-payment-target="overlay"
     <%= "hidden" unless open %>>
  <section class="tournament-buy-in-modal__card"
           role="dialog"
           aria-modal="true"
           aria-labelledby="buy-in-payment-title">
    <button type="button"
            class="tournament-buy-in-modal__close"
            aria-label="Fechar pagamento"
            data-action="buy-in-payment#close">×</button>

    <p class="tournament-buy-in-modal__eyebrow">Próximo passo</p>
    <h2 id="buy-in-payment-title">Pague o buy-in</h2>
    <p class="tournament-buy-in-modal__description">
      Realize o Pix usando os dados informados pelo organizador e avise quando concluir.
    </p>

    <dl class="tournament-buy-in-modal__details">
      <div>
        <dt>Valor</dt>
        <dd><%= number_to_currency(buy_in.amount) %></dd>
      </div>
      <div>
        <dt>Total de fichas</dt>
        <dd><%= number_with_delimiter(buy_in.chip_amount) %></dd>
      </div>
    </dl>

    <% if payment.present? %>
      <div class="tournament-buy-in-modal__manual-instructions" role="status">
        <p>Aguardando pagamento.</p>
        <span>Realize o Pix usando os dados informados pelo organizador. Após a confirmação, sua inscrição será concluída.</span>
      </div>
    <% else %>
      <div class="tournament-buy-in-modal__manual-instructions">
        <p>Pagamento por Pix</p>
        <span>A chave Pix do clube será exibida aqui após o cadastro pelo organizador.</span>
      </div>
    <% end %>
    <button type="button"
            class="tournament-buy-in-modal__later"
            data-action="buy-in-payment#close">
      Pagar depois
    </button>
  </section>
</div>
