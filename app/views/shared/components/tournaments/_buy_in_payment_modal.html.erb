<div class="tournament-buy-in-modal"
     data-buy-in-payment-target="overlay"
     <%= "hidden" unless open %>>
  <section class="tournament-buy-in-modal__card"
           role="dialog"
           aria-modal="true"
           aria-labelledby="buy-in-payment-title">
    <button type="button"
            class="tournament-buy-in-modal__close"
            aria-label="Fechar pagamento"
            data-action="buy-in-payment#close">×</button>

    <p class="tournament-buy-in-modal__eyebrow">Próximo passo</p>
    <h2 id="buy-in-payment-title">Pague o buy-in</h2>
    <p class="tournament-buy-in-modal__description">
      Escolha a forma de pagamento para garantir sua inscrição neste torneio.
    </p>

    <dl class="tournament-buy-in-modal__details">
      <div>
        <dt>Valor</dt>
        <dd><%= number_to_currency(buy_in.amount) %></dd>
      </div>
      <div>
        <dt>Total de fichas</dt>
        <dd><%= number_with_delimiter(buy_in.chip_amount) %></dd>
      </div>
    </dl>

    <div data-buy-in-payment-target="selection"
         <%= "hidden" if payment.present? %>>
      <%= form_with url: club_tournament_buy_in_payment_path(club, tournament),
                    method: :post,
                    scope: :user,
                    local: true,
                    class: "tournament-buy-in-modal__form",
                    data: { action: "submit->buy-in-payment#submit" } do |form| %>
        <% if current_user.name.blank? || current_user.cpf.blank? %>
          <fieldset class="tournament-buy-in-modal__identity-fields">
            <legend>Seus dados</legend>
            <p>Esses dados são necessários para gerar sua cobrança.</p>

            <div class="tournament-buy-in-modal__identity-fields-grid">
              <% if current_user.name.blank? %>
                <div class="tournament-buy-in-modal__field">
                  <%= form.label :name, "Nome completo" %>
                  <%= form.text_field :name,
                                      required: true,
                                      autocomplete: "name",
                                      class: "input tournament-buy-in-modal__input",
                                      placeholder: "Digite seu nome completo" %>
                </div>
              <% end %>
              <% if current_user.cpf.blank? %>
                <div class="tournament-buy-in-modal__field">
                  <%= form.label :cpf, "CPF" %>
                  <%= form.text_field :cpf,
                                      required: true,
                                      inputmode: "numeric",
                                      autocomplete: "off",
                                      class: "input tournament-buy-in-modal__input",
                                      placeholder: "000.000.000-00" %>
                </div>
              <% end %>
            </div>
          </fieldset>
        <% end %>

        <div class="tournament-buy-in-modal__methods" aria-label="Formas de pagamento">
          <button type="submit"
                  name="payment_method"
                  value="pix"
                  class="tournament-buy-in-modal__method"
                  data-buy-in-payment-target="submit">
            <span>Pix</span>
            <small>QR Code e copia e cola</small>
          </button>
          <button type="submit"
                  name="payment_method"
                  value="card"
                  class="tournament-buy-in-modal__method"
                  data-buy-in-payment-target="submit">
            <span>Cartão de crédito ou débito</span>
            <small>Pagamento seguro pelo Asaas</small>
          </button>
        </div>
      <% end %>
    </div>

    <% if payment&.pix? && payment.pix_qr_code_image.present? && payment.pix_payload.present? %>
      <div class="tournament-buy-in-modal__pix"
           aria-label="Pagamento Pix"
           data-buy-in-payment-target="pix">
        <p>Escaneie o QR Code ou copie o código Pix.</p>
        <%= image_tag "data:image/png;base64,#{payment.pix_qr_code_image}",
                      alt: "QR Code Pix do buy-in",
                      class: "tournament-buy-in-modal__pix-image" %>
        <label for="buy-in-pix-payload">Pix copia e cola</label>
        <input id="buy-in-pix-payload"
               class="tournament-buy-in-modal__pix-payload"
               type="text"
               value="<%= payment.pix_payload %>"
               readonly>
        <% if payment.pix_expiration_date.present? %>
          <p>Válido até <%= l(payment.pix_expiration_date, format: :short) %>.</p>
        <% end %>
        <button type="button"
                class="tournament-buy-in-modal__back"
                data-action="buy-in-payment#showSelection">
          Voltar para formas de pagamento
        </button>
      </div>
    <% end %>

    <% if payment&.card? && payment.provider_payment_url.present? %>
      <div class="tournament-buy-in-modal__card-payment"
           data-buy-in-payment-target="card">
        <p>Você será direcionado à página segura do Asaas para informar os dados do cartão.</p>
        <%= link_to "Ir para pagamento seguro",
                    payment.provider_payment_url,
                    class: "tournament-buy-in-modal__pay",
                    target: "_blank",
                    rel: "noopener noreferrer" %>
        <button type="button"
                class="tournament-buy-in-modal__back"
                data-action="buy-in-payment#showSelection">
          Voltar para formas de pagamento
        </button>
      </div>
    <% end %>
    <button type="button"
            class="tournament-buy-in-modal__later"
            data-action="buy-in-payment#close">
      Pagar depois
    </button>
  </section>
</div>
