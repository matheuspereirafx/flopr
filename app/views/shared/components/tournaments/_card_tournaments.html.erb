<section
  class="club-events"
  data-controller="horizontal-scroll tournament-filter"
>
  <header class="club-events__header">
    <h2<%= " id=\"#{local_assigns[:section_id]}\"" if local_assigns[:section_id].present? %> class="club-events__title">
      <%= local_assigns.fetch(:section_title, "Eventos") %>
    </h2>

    <% if local_assigns.fetch(:show_filters, true) %>
      <div class="club-events__filters">
        <button
          type="button"
          class="club-events__filter club-events__filter--active"
          data-tournament-filter-target="button"
          data-filter="all"
          data-action="click->tournament-filter#filter"
        >
          Todos
        </button>

        <button
          type="button"
          class="club-events__filter"
          data-tournament-filter-target="button"
          data-filter="live"
          data-action="click->tournament-filter#filter"
        >
          Ao vivo
        </button>

        <button
          type="button"
          class="club-events__filter"
          data-tournament-filter-target="button"
          data-filter="upcoming"
          data-action="click->tournament-filter#filter"
        >
          Próximos
        </button>
      </div>
    <% end %>
  </header>

  <% if tournaments.any? %>
    <div class="club-events__carousel">
      <button
        type="button"
        class="club-events__arrow club-events__arrow--previous"
        aria-label="Ver eventos anteriores"
        data-horizontal-scroll-target="previousButton"
        data-action="click->horizontal-scroll#previous"
      >
        ←
      </button>

      <div
        class="club-events__grid"
        data-horizontal-scroll-target="container"
        data-action="scroll->horizontal-scroll#updateButtons"
      >
        <% tournaments.each do |tournament| %>
          <% membership = local_assigns[:current_membership] ||
                          local_assigns.fetch(:current_memberships_by_club_id, {})[tournament.club_id] %>
          <% buy_in = tournament.charge_options.find do |option|
               option.buy_in? && option.active?
             end %>
          <% confirmed_registrations_count = confirmed_registrations_by_tournament.fetch(tournament.id, 0) %>
          <% tournament_path = if local_assigns.fetch(:show_join_prompt, false)
                                 club_tournament_path(tournament.club, tournament, join: true)
                               else
                                 club_tournament_path(tournament.club, tournament)
                               end %>

          <article
            class="tournament-card"
            data-tournament-filter-target="card"
            data-tournament-status="<%= tournament.status %>"
            data-clock-status="<%= tournament.clock_state&.status %>"
            data-starts-at="<%= tournament.starts_at.iso8601 %>"
          >
            <%= link_to tournament_path,
                        class: "tournament-card__link",
                        data: { turbo_prefetch: false },
                        aria: { label: "Ver detalhes do torneio #{tournament.name}" } do %>
            <div class="tournament-card__image-wrapper">
              <%= image_tag(
                tournament.cover.attached? ? tournament.cover : "backgroundshow.png",
                class: "tournament-card__image",
                alt: tournament.cover.attached? ? "Capa do torneio #{tournament.name}" : "Mesa de torneio de pôquer"
              ) %>

              <div class="tournament-card__statuses">
                <% unless membership&.player? %>
                  <span class="tournament-card__status tournament-card__status--<%= tournament.status %>">
                    <span class="tournament-card__status-dot"></span>
                    <%= t("activerecord.attributes.tournament.statuses.#{tournament.status}") %>
                  </span>
                <% end %>

                <% if tournament.clock_state.present? &&
                      !tournament.clock_state.not_started? &&
                      !tournament.clock_state.finished? %>
                  <% clock_status_label = {
                       "running" => "Ao vivo",
                       "paused" => "Pausado",
                       "overtime" => "Tempo extra",
                       "finished" => "Finalizado"
                     }.fetch(tournament.clock_state.status) %>
                  <span class="tournament-card__status tournament-card__status--clock tournament-card__status--<%= tournament.clock_state.status %>">
                    <span class="tournament-card__status-dot"></span>
                    <%= clock_status_label %>
                  </span>
                <% end %>
              </div>

            </div>

            <div class="tournament-card__content">
              <div class="tournament-card__heading">
                <% if local_assigns.fetch(:show_club_name, false) %>
                  <p class="tournament-card__club-name"><%= tournament.club.name %></p>
                <% end %>
                <h3 class="tournament-card__title">
                  <%= tournament.name %>
                </h3>

                <p class="tournament-card__type">
                  <%= tournament.location %>
                  <span>•</span>
                  <%= l(tournament.starts_at, format: :short) %>
                </p>
              </div>

              <div class="tournament-card__information">
                <div class="tournament-card__information-box">
                  <span class="tournament-card__information-label">
                    <%= image_tag(
                      "icons/iconcash.png",
                      alt: ""
                    ) %>

                    Buy-in
                  </span>

                  <strong
                    class="
                      tournament-card__information-value
                      tournament-card__information-value--highlight
                    "
                  >
                    <%= buy_in ? number_to_currency(buy_in.amount) : "A definir" %>
                  </strong>
                </div>

                <div class="tournament-card__information-box">
                  <span class="tournament-card__information-label">
                    <%= image_tag(
                      "icons/iconplayers.png",
                      alt: ""
                    ) %>

                    Players
                  </span>

                  <div class="tournament-card__players-value">
                    <strong>
                      <%= confirmed_registrations_count %>
                    </strong>

                    <span>
                      / <%= tournament.max_players %>
                    </span>
                  </div>
                </div>
              </div>

              <footer class="tournament-card__footer">
                <span class="tournament-card__level">
                  ◷ Nível 1 (100/200)
                </span>

                <span class="tournament-card__details">
                  Ver detalhes

                  <span>→</span>
                </span>
              </footer>
            </div>
            <% end %>

            <% if membership&.owner? || membership&.admin? %>
              <div class="tournament-card__menu">
                <%= render "shared/components/tournaments/tournament_menu_card",
                           tournament: tournament,
                           can_destroy: membership.owner? %>
              </div>
            <% end %>
          </article>
        <% end %>
      </div>

      <button
        type="button"
        class="club-events__arrow club-events__arrow--next"
        aria-label="Ver próximos eventos"
        data-horizontal-scroll-target="nextButton"
        data-action="click->horizontal-scroll#next"
      >
        →
      </button>
    </div>
  <% else %>
    <p class="club-events__empty">
      <%= local_assigns.fetch(:empty_message, "Nenhum torneio criado ainda.") %>
    </p>
  <% end %>
</section>
