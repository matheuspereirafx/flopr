<%= simple_form_for [club, tournament], html: { class: "tournament-form" } do |f| %>
  <section class="tournament-form__card">
    <h2 class="tournament-form__card-title">Informações básicas</h2>

    <div class="tournament-form__divider"></div>

    <div class="tournament-form__fields">
      <%= f.input :name,
                  label: "Nome do torneio",
                  placeholder: "Ex.: Friday Night High Roller",
                  input_html: { class: "tournament-form__input" } %>

      <%= f.input :starts_at,
                  as: :datetime,
                  html5: true,
                  label: "Data e horário",
                  input_html: { class: "tournament-form__input" } %>

      <%= f.input :location,
                  label: "Local",
                  placeholder: "Ex.: The Poker Room, Mesa 1",
                  input_html: { class: "tournament-form__input" } %>

      <%= f.input :max_players,
                  label: "Máximo de jogadores",
                  placeholder: "Ex.: 30",
                  input_html: {
                    class: "tournament-form__input",
                    min: 1
                  } %>
    </div>
  </section>

  <footer class="tournament-form__actions">
    <%= link_to "Cancelar",
                club_path(club),
                class: "tournament-form__cancel-button" %>

    <%= f.button :submit,
                 tournament.persisted? ? "Salvar alterações" : "Criar torneio",
                 class: "tournament-form__submit-button" %>
  </footer>
<% end %>
