<section class="overview-prize-pool" aria-labelledby="overview-prize-pool-title">
  <h2 id="overview-prize-pool-title">Resultados do torneio</h2>

  <% if can_view_amount && prize_pool.present? %>
    <div data-controller="tournament-financials"
         data-tournament-financials-club-id-value="<%= club.id %>"
         data-tournament-financials-tournament-id-value="<%= tournament.id %>">
      <p class="overview-prize-pool__amount">
        Premiação total:
        <strong data-tournament-financials-target="amount">
          R$ <%= number_to_currency(prize_pool.net_amount, unit: "", separator: ",", delimiter: ".") %>
        </strong>
      </p>
      <ol class="overview-prize-pool__placements">
        <% prize_pool.prize_distribution.each do |entry| %>
          <%= render "shared/components/tournaments/overview_prize_position",
                     prize_position: entry[:position],
                     prize_amount: entry[:amount] %>
        <% end %>
      </ol>
    </div>
  <% else %>
    <p class="overview-prize-pool__hint">Premiação ainda não configurada.</p>
  <% end %>

  <% if can_configure && prize_pool.present? %>
    <%= link_to "Configurar premiação", edit_club_tournament_prize_pool_path(club, tournament), class: "button button--ghost" %>
  <% end %>
</section>
