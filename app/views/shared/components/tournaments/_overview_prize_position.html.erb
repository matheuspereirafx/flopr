<% if prize_position.position == 1 %>
  <li class="overview-prize-pool__winner">
    <span class="overview-prize-pool__trophy">
      <%= image_tag "icons/figma-trophy.svg", alt: "" %>
    </span>
    <div class="overview-prize-pool__winner-player">
      <span>Campeão</span>
      <strong>Jogador não definido</strong>
    </div>
    <strong class="overview-prize-pool__winner-value">
      <%= number_to_currency(prize_amount, unit: "R$ ", separator: ",", delimiter: ".") %>
    </strong>
  </li>
<% else %>
  <li class="overview-prize-pool__placement">
    <strong class="overview-prize-pool__position"><%= prize_position.position %>º</strong>
    <span>Jogador não definido</span>
    <strong><%= number_to_currency(prize_amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
  </li>
<% end %>
