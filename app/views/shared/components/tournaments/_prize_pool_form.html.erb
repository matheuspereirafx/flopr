<div class="page">
  <main class="tournament-form prize-pool-form" aria-labelledby="page-title">
    <header class="tournament-form__header prize-pool-form__header">
      <p class="prize-pool-form__step">Etapa 3 de 3</p>
      <h1 id="page-title" class="tournament-form__title">Configuração da premiação</h1>
      <p class="tournament-form__subtitle">
        Defina o valor total e a distribuição entre as posições premiadas em
        <strong><%= tournament.name %></strong>.
      </p>
    </header>

    <%= form_with model: prize_pool,
                  scope: :prize_pool,
                  url: club_tournament_prize_pool_path(club, tournament),
                  method: editing ? :patch : :post,
                  class: "tournament-form__body",
                  data: { controller: "prize-pool-form",
                          action: "input->prize-pool-form#updateTotal" } do |form| %>
      <div class="tournament-form__content">
        <div class="form-grid prize-pool-form__grid">
          <fieldset class="panel prize-pool-panel">
            <legend class="panel__title">Valor da premiação</legend>
            <p class="prize-pool-panel__description">
              Informe o valor total que será distribuído entre as posições.
            </p>
            <div class="field">
              <%= form.label :total_amount, "Valor total da premiação", class: "field__label" %>
              <div class="prize-pool-amount">
                <span aria-hidden="true">R$</span>
                <%= form.number_field :total_amount, class: "input", min: "0.01", step: "0.01", placeholder: "1.000,00" %>
              </div>
            </div>
          </fieldset>

          <fieldset class="panel prize-pool-panel">
            <legend class="panel__title">Distribuição da premiação</legend>
            <p class="prize-pool-panel__description">
              Configure o percentual destinado a cada posição. Os percentuais devem totalizar 100%.
            </p>

            <div class="prize-pool-positions" data-prize-pool-form-target="positions">
              <div class="prize-pool-positions__header" aria-hidden="true">
                <span>Posição</span><span>Percentual</span><span></span>
              </div>
              <%= form.fields_for :prize_positions do |position_fields| %>
                <%= render "shared/components/tournaments/prize_position_fields",
                           position_fields: position_fields %>
              <% end %>
            </div>

            <template data-prize-pool-form-target="template">
              <%= form.fields_for :prize_positions,
                                  TournamentPrizePosition.new,
                                  child_index: "NEW_RECORD" do |position_fields| %>
                <%= render "shared/components/tournaments/prize_position_fields",
                           position_fields: position_fields %>
              <% end %>
            </template>

            <button type="button" class="button button--secondary prize-pool-form__add"
                    data-action="prize-pool-form#addPosition">
              <i data-lucide="plus"></i> Adicionar posição
            </button>

            <div class="prize-pool-total" data-prize-pool-form-target="total" data-state="incomplete" aria-live="polite">
              <div>
                <span>Total distribuído</span>
                <strong data-prize-pool-form-target="totalValue">0%</strong>
              </div>
              <p class="prize-pool-total__message" data-prize-pool-form-target="totalMessage" role="status"></p>
            </div>
          </fieldset>
        </div>

        <div class="tournament-form__actions">
          <%= link_to edit_club_tournament_charge_options_path(club, tournament),
                      class: "button button--ghost prize-pool-form__back", data: { turbo_prefetch: false },
                      aria: { label: "Voltar para configurações financeiras" },
                      title: "Voltar para configurações financeiras" do %>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m15 18-6-6 6-6" />
            </svg>
            <span class="sr-only">Voltar</span>
          <% end %>
          <%= button_tag type: "submit", class: "button button--primary",
                         disabled: true,
                         data: { prize_pool_form_target: "submit" } do %>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m5 12 4 4L19 6" />
            </svg>
            <span class="sr-only"><%= editing ? "Salvar alterações" : "Salvar premiação" %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </main>
</div>
