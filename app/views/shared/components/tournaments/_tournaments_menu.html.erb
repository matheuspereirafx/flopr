<div
  class="resource-menu"
  data-controller="resource-menu"
  data-action="click@window->resource-menu#closeOutside">

  <button
    class="menu-button"
    type="button"
    aria-label="Abrir opções do torneio"
    aria-expanded="false"
    data-resource-menu-target="button"
    data-action="click->resource-menu#toggle"
  >
    ⋮
  </button>

  <div
    class="resource-menu-dropdown"
    data-resource-menu-target="dropdown"
    hidden
  >
    <%= link_to edit_club_path(club),
        class: "resource-menu-item" do %>

      <span>Editar Torneio</span>

    <% end %>

    <%= button_to club_path(club),
        method: :delete,
        class: "resource-menu-item resource-menu-item--danger",
        form: {
          data: {
            turbo_confirm: "Tem certeza que deseja excluir este Torneio?"
          }
        } do %>

      <span>Excluir Torenio</span>

    <% end %>
  </div>
</div>
