<section class="tournament-clock-blinds" aria-label="Blinds do nível atual">
  <article class="tournament-clock-blind">
    <span class="tournament-clock-blind__label">Small blind</span>
    <strong class="tournament-clock-blind__value" data-tournament-clock-target="smallBlind"><%= number_with_delimiter(current_blind_level.small_blind, delimiter: ".") %></strong>
  </article>
  <span class="tournament-clock-blinds__separator" aria-hidden="true">/</span>
  <article class="tournament-clock-blind tournament-clock-blind--featured">
    <span class="tournament-clock-blind__label">Big blind</span>
    <strong class="tournament-clock-blind__value" data-tournament-clock-target="bigBlind"><%= number_with_delimiter(current_blind_level.big_blind, delimiter: ".") %></strong>
  </article>
  <span class="tournament-clock-blinds__separator" aria-hidden="true">/</span>
  <article class="tournament-clock-blind">
    <span class="tournament-clock-blind__label">Ante</span>
    <strong class="tournament-clock-blind__value" data-tournament-clock-target="ante"><%= number_with_delimiter(current_blind_level.ante, delimiter: ".") %></strong>
  </article>

  <div class="tournament-clock-next-level">
    <% if next_blind_level.present? %>
      <span class="tournament-clock-next-level__label" data-tournament-clock-target="nextLevelLabel">Próximo nível (<%= next_blind_level.level %>)</span>
      <strong data-tournament-clock-target="nextLevelValues"><%= number_with_delimiter(next_blind_level.small_blind, delimiter: ".") %> / <%= number_with_delimiter(next_blind_level.big_blind, delimiter: ".") %> / <%= number_with_delimiter(next_blind_level.ante, delimiter: ".") %></strong>
      <span class="tournament-clock-next-level__duration" data-tournament-clock-target="nextLevelDuration"><%= next_blind_level.duration_minutes %> min</span>
    <% else %>
      <span class="tournament-clock-next-level__label" data-tournament-clock-target="nextLevelLabel">Estrutura de blinds</span>
      <strong data-tournament-clock-target="nextLevelValues">Último nível configurado</strong>
      <span class="tournament-clock-next-level__duration" data-tournament-clock-target="nextLevelDuration"></span>
    <% end %>
  </div>
</section>
