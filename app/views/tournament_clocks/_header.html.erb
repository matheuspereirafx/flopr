<header class="tournament-clock-header">
  <div class="tournament-clock-header__context">
    <p class="sr-only"><%= club.name %></p>
    <h1 id="clock-page-title" class="sr-only"><%= tournament.name %></h1>
    <p class="tournament-clock-header__level" data-tournament-clock-target="level">
      LEVEL <%= current_blind_level.level %> A <%= tournament.blind_levels.size %>
    </p>
    <p class="tournament-clock-header__duration" data-tournament-clock-target="duration">
      ◷ <%= current_blind_level.duration_minutes %> min de duração
    </p>

    <% can_advance_clock = current_membership.owner? || current_membership.admin? %>
    <div class="tournament-clock-header__actions <%= "tournament-clock-header__actions--single" if clock_state.not_started? || clock_state.paused? || !can_advance_clock %>">
      <% if (current_membership.owner? || current_membership.admin?) && clock_state.not_started? %>
        <%= button_to "▶", start_club_tournament_clock_path(club, tournament),
                      class: "tournament-clock-control tournament-clock-control--primary",
                      aria: { label: "Iniciar relógio" } %>
      <% elsif (current_membership.owner? || current_membership.admin? || current_membership.dealer?) && (clock_state.running? || clock_state.overtime?) %>
        <% if can_advance_clock %>
          <%= button_to ">", advance_club_tournament_clock_path(club, tournament),
                        method: :patch,
                        class: "tournament-clock-header__action-arrow",
                        aria: { label: "Avançar nível" } %>
        <% end %>
        <%= button_to "", pause_club_tournament_clock_path(club, tournament),
                      method: :patch,
                      class: "tournament-clock-control tournament-clock-control--pause",
                      aria: { label: "Pausar relógio" } %>
      <% elsif (current_membership.owner? || current_membership.admin?) && clock_state.paused? %>
        <%= button_to "▶", resume_club_tournament_clock_path(club, tournament),
                      method: :patch,
                      class: "tournament-clock-control tournament-clock-control--primary",
                      aria: { label: "Retomar relógio" } %>
      <% end %>
    </div>
  </div>

  <span class="tournament-clock-status tournament-clock-status--<%= clock_state.status %>"
        data-tournament-clock-target="status">
    <span class="tournament-clock-status__dot" aria-hidden="true"></span>
    <span data-tournament-clock-target="statusLabel"><%= clock_in_overtime ? "Tempo extra" : clock_state.status.humanize %></span>
  </span>
</header>
