<% current_blind_level = clock_state.current_blind_level %>
<% next_blind_level = clock_state.tournament.blind_levels.find_by("level > ?", current_blind_level.level) %>
<% payload = {
     status: clock_state.status,
     current_blind_level_id: current_blind_level.id,
     remaining_seconds: clock_state.remaining_seconds,
     overtime_elapsed_seconds: clock_state.overtime_seconds,
     current_level: current_blind_level.slice(:id, :level, :duration_minutes, :small_blind, :big_blind, :ante),
     next_level: next_blind_level&.slice(:id, :level, :duration_minutes, :small_blind, :big_blind, :ante)
   } %>

<div id="tournament-clock-state-<%= clock_state.tournament_id %>"
     data-tournament-clock-target="state"
     data-tournament-clock-state-payload="<%= json_escape(payload.to_json) %>"
     hidden></div>
