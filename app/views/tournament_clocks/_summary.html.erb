<section class="tournament-clock-summary" aria-label="Resumo do torneio">
  <article class="tournament-clock-summary-card">
    <p class="tournament-clock-summary-card__title">♙ Players</p>
    <strong class="tournament-clock-summary-card__empty">Aguardando inscrições</strong>
    <p class="tournament-clock-summary-card__hint">Ativos e eliminados aparecerão aqui.</p>
  </article>

  <article class="tournament-clock-summary-card tournament-clock-summary-card--prize">
    <p class="tournament-clock-summary-card__title">◎ Prize pool</p>
    <strong class="tournament-clock-summary-card__empty">A definir</strong>
    <p class="tournament-clock-summary-card__hint">Disponível após a definição financeira.</p>
  </article>

  <aside class="tournament-clock-charge-options" aria-label="Recargas disponíveis">
    <p class="tournament-clock-charge-options__title">◉ Registration</p>
    <% if available_charge_options.any? %>
      <ul class="tournament-clock-charge-options__list">
        <% available_charge_options.each do |option| %>
          <li><%= option.kind.humanize %><span><%= number_to_currency(option.amount) %></span></li>
        <% end %>
      </ul>
    <% else %>
      <p class="tournament-clock-charge-options__empty">Nenhuma recarga liberada neste nível.</p>
    <% end %>
  </aside>
</section>
