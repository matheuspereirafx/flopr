<main class="tournament-clock-page" aria-labelledby="clock-page-title">
  <div class="tournament-clock-page__background" aria-hidden="true"></div>

  <%= turbo_stream_from [@tournament, :clock] %>

  <section class="tournament-clock-page__content"
           data-controller="tournament-clock"
           data-tournament-clock-seconds-value="<%= @clock_display_seconds %>"
           data-tournament-clock-running-value="<%= @clock_state.running? || @clock_state.overtime? %>"
           data-tournament-clock-overtime-value="<%= @clock_in_overtime %>"
           data-tournament-clock-current-level-id-value="<%= @current_blind_level.id %>"
           data-tournament-clock-total-levels-value="<%= @tournament.blind_levels.size %>"
           data-tournament-clock-sound-storage-key-value="tournament-clock-sound-<%= @tournament.id %>"
           data-tournament-clock-state-url-value="<%= state_club_tournament_clock_path(@club, @tournament) %>">
    <%= render "tournament_clocks/state", clock_state: @clock_state %>
    <%= render "tournament_clocks/header",
               club: @club,
               tournament: @tournament,
               current_membership: @current_membership,
               clock_state: @clock_state,
               current_blind_level: @current_blind_level,
               next_blind_level: @next_blind_level,
               clock_in_overtime: @clock_in_overtime %>

    <article class="tournament-clock-timer" aria-live="polite">
      <p class="tournament-clock-timer__eyebrow sr-only">
        <%= @clock_in_overtime ? "Tempo extra" : "Tempo restante" %>
      </p>
      <strong class="tournament-clock-timer__value" data-tournament-clock-target="timer">
        <%= @clock_in_overtime ? "+" : "" %><%= format("%02d : %02d", @clock_display_seconds / 60, @clock_display_seconds % 60) %>
      </strong>
    </article>

    <audio data-tournament-clock-target="audio" preload="auto">
      <source src="<%= asset_path("timerblind.m4a") %>" type="audio/mp4">
    </audio>

    <dialog class="tournament-clock-sound-dialog"
            data-tournament-clock-target="soundDialog"
            aria-labelledby="sound-dialog-title">
      <h2 id="sound-dialog-title">Ativar alerta sonoro</h2>
      <p>Ative o som para ouvir o aviso nos últimos 12 segundos de cada nível.</p>
      <button type="button"
              class="tournament-clock-sound-dialog__confirm"
              data-action="tournament-clock#enableSound"
              data-tournament-clock-target="soundButton">
        Ativar som
      </button>
    </dialog>

    <%= render "tournament_clocks/blinds",
               current_blind_level: @current_blind_level,
               next_blind_level: @next_blind_level %>

    <%= render "tournament_clocks/summary",
               available_charge_options: @available_charge_options %>
  </section>
</main>
