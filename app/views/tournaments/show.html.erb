<main class="tournament-show-page" aria-labelledby="tournament-title">
  <header class="tournament-show-page__header">
    <%= link_to "← Voltar ao clube", club_path(@club), class: "tournament-show-page__back" %>
    <span class="tournament-show-page__status"><%= @tournament.status.humanize %></span>
  </header>

  <section class="tournament-show-page__hero">
    <p class="tournament-show-page__club"><%= @club.name %></p>
    <h1 id="tournament-title"><%= @tournament.name %></h1>
    <p><%= @tournament.location %> <span aria-hidden="true">·</span> <%= l(@tournament.starts_at, format: :short) %></p>
  </section>

  <section class="tournament-show-page__details" aria-label="Informações do torneio">
    <article>
      <span>Buy-in</span>
      <strong><%= @buy_in ? number_to_currency(@buy_in.amount) : "A definir" %></strong>
    </article>
    <article>
      <span>Capacidade</span>
      <strong><%= @tournament.max_players %> jogadores</strong>
    </article>
    <article>
      <span>Estrutura</span>
      <strong><%= @tournament.blind_levels.count %> níveis</strong>
    </article>
  </section>

  <section class="tournament-show-page__actions" aria-label="Áreas do torneio">
    <%= link_to "Abrir relógio", club_tournament_clock_path(@club, @tournament), class: "tournament-show-page__clock-link" %>
  </section>
</main>
