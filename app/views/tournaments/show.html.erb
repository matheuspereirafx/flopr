<div class="tournament-show-shell">
  <%= render "shared/components/tournaments/navigation",
             club: @club,
             tournament: @tournament,
             current_membership: @current_membership,
             current_registration: @invite_registration,
             active_page: :overview %>

<main class="tournament-overview-page" aria-labelledby="tournament-title">
  <header class="tournament-overview-page__header overview-header">
    <% if @current_membership&.player? %>
      <%= link_to "← Voltar aos torneios",
                  player_tournaments_path,
                  class: "overview-header__back",
                  data: { turbo_prefetch: false } %>
    <% elsif @current_membership.present? %>
      <%= link_to "← Voltar ao clube", club_path(@club),
                  class: "overview-header__back",
                  data: { turbo_prefetch: false } %>
    <% end %>
    <% if @current_membership&.owner? || @current_membership&.admin? %>
      <button class="overview-header__invite"
              type="button"
              aria-label="Copiar link de convite"
              title="Copiar link de convite"
              data-controller="copy-invite-link"
              data-copy-invite-link-url-value="<%= @invite_url %>"
              data-copied-message="Link copiado"
              data-action="click->copy-invite-link#copy">
        <%= image_tag "icons/iconshare.svg", alt: "" %>
      </button>
    <% end %>

    <div class="overview-header__content">
      <div class="overview-header__information">
        <h1 id="tournament-title"><%= @tournament.name %></h1>
        <p class="overview-header__address">
          <%= image_tag "icons/Iconlocation.svg", alt: "" %>
          <span><%= @tournament.location %></span>
        </p>
        <div class="overview-header__meta">
          <% if @current_membership&.owner? ||
                @current_membership&.admin? ||
                @current_membership&.dealer? %>
            <span class="overview-header__status overview-header__status--<%= @tournament.status %>">
              <%= t("activerecord.attributes.tournament.statuses.#{@tournament.status}") %>
            </span>
          <% end %>
          <time class="overview-header__date" datetime="<%= @tournament.starts_at.iso8601 %>">
            <%= image_tag "icons/Icondate.svg", alt: "" %>
            <%= l(@tournament.starts_at, format: :short) %>
          </time>
        </div>
      </div>
    </div>
  </header>

  <%= render "shared/components/tournaments/overview_participation",
             confirmed_registrations_count: @confirmed_registrations_count,
             pending_registrations_count: @pending_registrations_count,
             available_slots_count: @available_slots_count %>

  <section class="tournament-overview-page__main" aria-label="Resumo do torneio">
    <%= render "shared/components/tournaments/overview_prize_pool" %>
    <%= render "shared/components/tournaments/overview_details", tournament: @tournament %>
  </section>
</main>
</div>

<% if @invite_token_access && @invite_registration.blank? %>
  <div class="tournament-invitation-overlay" role="dialog" aria-modal="true" aria-labelledby="tournament-invitation-title">
    <section class="tournament-invitation-overlay__card">
      <h2 id="tournament-invitation-title">Convite para torneio</h2>
      <%= button_to "Confirmar presença",
                    confirm_tournament_invitation_path(@tournament.invite_token),
                    method: :patch,
                    class: "tournament-invitation-overlay__button" %>
    </section>
  </div>
<% end %>

<% if @invite_registration&.pending? && @buy_in.present? %>
  <div data-controller="buy-in-payment"
       data-buy-in-payment-open-value="<%= @buy_in_payment_modal_open %>">
    <button type="button"
            class="tournament-buy-in-trigger"
            data-buy-in-payment-target="trigger"
            data-action="buy-in-payment#open">
      Pagar buy-in
    </button>

    <%= render "shared/components/tournaments/buy_in_payment_modal",
               club: @club,
               tournament: @tournament,
               buy_in: @buy_in,
               payment: @pending_buy_in_payment,
               open: @buy_in_payment_modal_open %>
  </div>
<% end %>
